  - Id: spin_plus
    En: +{0} spins
    Ru: "+{0} \u0441\u043F\u0438\u043D\u043E\u0432"
  - Id: vip_header
    En: <color=#fff000><b>VIP</b></color> Status
    Ru: "<color=#fff000><b>VIP</b></color> \u0441\u0442\u0430\u0442\u0443\u0441"
  - Id: vip_1
    En: '- All collected energy is multiplied <b>2 times</b>'
    Ru: "- \u0432\u0441\u044F \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u0430\u044F
      \u044D\u043D\u0435\u0440\u0433\u0438\u044F \u0443\u043C\u043D\u043E\u0436\u0430\u0435\u0442\u0441\u044F
      <b>\u0432 2 \u0440\u0430\u0437\u0430</b>"
  - Id: vip_2
    En: '- Time-based rewards are given<b> 2 times</b> faster'
    Ru: "- \u043D\u0430\u0433\u0440\u0430\u0434\u044B \u0437\u0430 \u0432\u0440\u0435\u043C\u044F
      \u0434\u0430\u044E\u0442\u0441\u044F <b>\u0432 2 \u0440\u0430\u0437\u0430</b>
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435"
  - Id: vip_3
    En: '- The crown on the player and in the Top will be visible to all players'
    Ru: "- \u043A\u043E\u0440\u043E\u043D\u0430 \u043D\u0430 \u0438\u0433\u0440\u043E\u043A\u0435
      \u0438 \u0432 \u0422\u043E\u043F\u0435, \u0431\u0443\u0434\u0435\u0442 \u0432\u0438\u0434\u043D\u0430
      \u0432\u0441\u0435\u043C \u0438\u0433\u0440\u043E\u043A\u0430\u043C"
  - Id: show_crown
    En: Show the Crown on the player
    Ru: "\u041F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u041A\u043E\u0440\u043E\u043D\u0443
      \u043D\u0430\u0434 \u0438\u0433\u0440\u043E\u043A\u043E\u043C"
  - Id: space_key
    En: SPACE
    Ru: "\u041F\u0420\u041E\u0411\u0415\u041B"
  - Id: tap_on_screen
